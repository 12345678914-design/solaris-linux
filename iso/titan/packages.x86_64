#!/bin/bash
#
# Titan Linux 1.8 - lista de paquetes de la ISO en vivo.
#
# Criterio: lo minimo para que un Titan Linux arranque y sirva para trabajar
# desde la consola, mas la cadena de herramientas que el proyecto necesita.
#
# El kernel del proyecto NO aparece aqui a proposito: lo anade
# scripts/build-iso.sh con 'mkarchiso -p linux-titanlinux' en cuanto existe
# kernel/linux-titanlinux/*.pkg.tar.zst. Asi este fichero no depende de si el
# kernel propio ya esta construido, y la ISO se puede reconstruir sin recompilar
# nada. Si el paquete aun no existe, la ISO arranca con el kernel de Arch.

# --- Nucleo e initramfs -----------------------------------------------------
# linux = kernel de Arch. Se queda como entrada de rescate: es el kernel que
# Arch mantiene y el unico que no depende de nuestro PKGBUILD.
# El kernel propio, linux-titanlinux, lo anade scripts/build-iso.sh con
# 'mkarchiso -p linux-titanlinux' en cuanto existe
# kernel/linux-titanlinux/*.pkg.tar.zst. Asi el perfil no depende de si el
# kernel propio ya esta construido o no.
linux

# --- Microcódigo y Firmware para hardware real ---
intel-ucode
amd-ucode
linux-firmware
linux-firmware-whence
sof-firmware
alsa-firmware

# --- Sistema base ----------------------------------------------------------
# base aporta bash, coreutils, util-linux, findutils, grep, sed, gawk, pacman,
# systemd, file, shadow, y el resto del arbol de utilidades basicas.
base
archlinux-keyring

mkinitcpio
mkinitcpio-archiso

# --- Arranque (BIOS con syslinux, UEFI con grub) ---------------------------
syslinux
grub
efibootmgr
dosfstools
mtools

# --- Comandos basicos de Linux, explicitos para que quede documentado ------
coreutils
findutils
grep
sed
gawk
diffutils
file
which
tree
bc
procps-ng
psmisc
iproute2
iputils
pciutils
usbutils
inetutils
ethtool
lsof
strace
e2fsprogs
# parted y os-prober: los necesita el instalador (Fase 3). Se meten ya para
# que la ISO en vivo sirva para instalar sin reconstruirse.
parted
os-prober
tar
gzip
bzip2
xz
zstd
unzip
jq
# bind aporta dig, host y nslookup (inetutils no los trae en Arch).
bind

# --- Editores, visor y ayuda ----------------------------------------------
nano
vim
less
man-pages
man-db
bash-completion
htop

# --- Titulos y herramientas de desarrollo ----------------------------------
git
curl
wget
rsync
sudo
ripgrep
fd
bat
fzf

# --- Titan Linux: identidad visual e informacion del sistema --------------
fastfetch

# --- Instalador -------------------------------------------------------------
# El instalador (root/install.sh) necesita todo esto. Va en la ISO desde el
# principio para que la ISO sirva para instalar sin reconstruirse.
arch-install-scripts
# dialog: las ventanas del instalador en MODO DE TEXTO. Antes se pondria aqui
# whiptail, pero ya no existe en Arch (era un script que dialog hacia de
# envoltorio, y dialog 1.3-20260721 lo quito del paquete). El instalador habla
# dialog.
dialog
# gptfdisk aporta sgdisk: el particionado automatico del instalador. Ojo, el
# paquete se llama gptfdisk, no gdisk (ese nombre es de un programa ancient).
gptfdisk
# btrfs-progs: para poder elegir btrfs como sistema de ficheros.
btrfs-progs
# cryptsetup: para poder cifrar el disco (LUKS2).
cryptsetup
# iw y wpa_supplicant: el paso de red del instalador sabe conectar a una red
# wifi si la maquina arranca sin cable. En un live sin NetworkManager, el
# camino es iw para buscar y wpa_supplicant para autenticarse.
iw
wpa_supplicant

# --- Utilidades y soporte del Instalador Gráfico ---
squashfs-tools
ckbcomp
hwinfo

# --- Utilidades de la ISO en vivo ------------------------------------------
# Entrada de red por DHCP en el live, con systemd-networkd.
systemd-resolvconf
# Terminal con historial para la consola de texto del live. No es un capricho:
# la consola del kernel NO puede hacer scroll (ver /etc/tmux.conf y el
# apartado "Historial de la consola" del README). tmux es lo que permite
# volver a leer lo que se sale de la pantalla. Solo envuelve tty1; la consola
# por serie (ttyS0), que usan las pruebas automaticas, no pasa por aqui.
tmux

# --- Escritorio grafico (Wayland) ------------------------------------------
# Decision de proyecto: escritorio propio en Qt 6, no un escritorio completo.
#   labwc         compositor de ventanas (Wayland, ligero; hereda openbox)
#   dbus          bus de sesion que necesita labwc y el escritorio
#   qt6-base      bibliotecas de Qt 6 (el binario titan-desktop)
#   qt6-wayland   el plugin de Qt que dibuja sobre Wayland (sin el, los
#                 programas Qt no arrancan dentro de labwc)
#   mesa          OpenGL/EGL por software (llvmpipe) cuando QEMU o una maquina
#                 sin aceleracion no ofrecen GPU; kitty lo necesita
#   kitty         terminal del escritorio (elegido por ser rapido y ligero)
#   pcmanfm-qt    explorador de archivos en Qt, sin arrastrar la pila KDE
#   layer-shell-qt  convierte la barra, el centro y el fondo en superficies
#                 Wayland con zona exclusiva y capas (sin el, serian ventanas
#                 normales que taparian a las demas o saldrian en la barra)
#   qt6-svg       iconos SVG del tema (los .desktop usan iconos vectoriales)
#   hicolor-icon-theme  iconos base cuando el tema no trae uno concreto
#   ttf-dejavu    tipografia con los bloques y simbolos del banner
#   xdg-utils     xdg-open, que usan el explorador y los menus "abrir con"
#   wayfire       compositor de la sesion inmersiva (con GPU 3D): animaciones
#                 de ventana (zoom, minimizar al Dock, deformacion al mover),
#                 desenfoque real tras los paneles y vistas de ventanas y
#                 escritorios. Config: ~/.config/wayfire.ini
# Compositores (los dos stacking): Wayfire con GPU, labwc de respaldo sin 3D
wayfire
labwc
xorg-xwayland
# GSettings para GTK (orden de los botones de ventana: semaforos a la izquierda)
dconf
# Portapapeles compartido con el anfitrion cuando corre en una VM
spice-vdagent
dbus
qt6-base
qt6-wayland
qt6-svg
layer-shell-qt
hicolor-icon-theme
mesa
mesa-utils
vulkan-intel
vulkan-radeon
vulkan-nouveau
vulkan-swrast

# --- Controladores Gráficos Modernos: NVIDIA, Intel y AMD ---
# nvidia-open-dkms (no nvidia-open): el paquete precompilado solo vale para el
# kernel de Arch. Con DKMS el modulo se compila tambien para linux-titanlinux
# (sus cabeceras las anade build-iso.sh) y se recompila solo al actualizar.
# Sin esto, con una NVIDIA sola el kernel por defecto se quedaba sin grafica:
# nvidia-utils pone nouveau en lista negra.
nvidia-open-dkms
dkms
linux-headers
nvidia-utils
nvidia-settings
nvidia-prime
egl-wayland
libva-nvidia-driver
opencl-nvidia
intel-media-driver
libva-intel-driver
xf86-video-amdgpu
xf86-video-ati
xf86-video-intel
xf86-video-nouveau
kitty
pcmanfm-qt
ttf-dejavu
# Fuentes del escritorio: Inter (interfaz, la mas cercana a SF de las libres)
# y JetBrains Mono (terminal). Se eligen en /etc/fonts/local.conf.
inter-font
ttf-jetbrains-mono
# Emojis de color de las apps (📦 🔒 🎵...): sin esta fuente salen como cuadros vacios
noto-fonts-emoji
xdg-utils

# --- Qt Quick Shell moderno estilo macOS ---
qt6-declarative
qt6-multimedia
qt6-multimedia-ffmpeg
taglib
qmltermwidget

# --- Soporte de AppImages y aplicaciones adicionales ---
fuse2

# --- Control de Hardware: Audio, Brillo, Red, Bluetooth y Discos/USBs ---
brightnessctl
ddcutil
wlr-randr
rfkill
bluez
bluez-utils
pipewire
pipewire-pulse
pipewire-alsa
pipewire-jack
wireplumber
alsa-utils
alsa-firmware
alsa-ucm-conf
sof-firmware
pavucontrol
networkmanager
udisks2

# --- Tienda de Aplicaciones y Apps GNOME ---
# Discover (KDE) para Flatpak y firmware (fwupd). Sin packagekit-qt6 a
# proposito: KDE avisa de que gestionar paquetes de Arch desde Discover esta
# incompleto; el sistema se actualiza con pacman desde Ajustes. El envoltorio
# /usr/local/bin/plasma-discover le da el tema claro/oscuro de Inti OS.
discover
gnome-calculator
gnome-calendar
gnome-clocks
totem
celluloid
flatpak
archlinux-appstream-data
qqc2-desktop-style
fwupd
mpv

# --- Optimización de Rendimiento y Gráficos (Intel Celeron / 4 GB RAM) ---
zram-generator
intel-media-driver
libva-intel-driver

# --- Aplicaciones incluidas en la ISO ---
firefox
# Firefox en español (como Ubuntu: sin esto sale en inglés)
firefox-i18n-es-es
firefox-i18n-es-mx
# Correo (como Ubuntu: Thunderbird; la tecla Correo y los enlaces mailto: lo abren)
thunderbird
thunderbird-i18n-es-es
# Camara web (como Fedora: Snapshot) y escritorio remoto (VNC; Ajustes > Compartir)
snapshot
wayvnc



wtype
# Inicio de sesion grafico multiusuario (sistema instalado)
greetd
cage

# --- Escritorio completo: lo que Ubuntu y Fedora traen de serie -------------
# Ver verify/comprobar-escritorio-completo.sh: cada bloque tiene su prueba.
# Contrasena de administrador en ventana (agente propio titan-polkit, Qt 6)
polkit-qt6
# Llavero de contrasenas (Secret Service) para Firefox, Wi-Fi, VS Code...
gnome-keyring
libsecret
# Compartir pantalla (Meet, Zoom, Discord, OBS) y capturas por portal
xdg-desktop-portal-wlr
xdg-desktop-portal-gtk
# Capturas de pantalla (titan-captura) y portapapeles de Wayland
grim
slurp
wl-clipboard
libnotify
# Bloqueo seguro (ext-session-lock: si algo se cae, la sesion sigue bloqueada)
# e inactividad (bloquear, apagar pantalla, suspender)
gtklock
gtklock-userinfo-module
gtklock-powerbar-module
gtklock-playerctl-module
swayidle
wlopm
wlsunset
sound-theme-freedesktop
playerctl
# Impresoras y escaneres (IPP Everywhere sin drivers + escaneres de red)
cups
cups-pk-helper
cups-browsed
cups-filters
system-config-printer
ipp-usb
sane
sane-airscan
simple-scan
avahi
nss-mdns
# Discos: NTFS/exFAT, moviles (MTP), papelera y carpetas de red en Finder
ntfs-3g
exfatprogs
gvfs
gvfs-mtp
gvfs-smb
gvfs-gphoto2
gnome-disk-utility
smartmontools
# Energia: perfiles (ahorro/equilibrado/rendimiento) y bateria
power-profiles-daemon
upower
# Cortafuegos (entrante cerrado salvo SSH y mDNS; ver titan-cortafuegos)
ufw
# Puntos de restauracion: btrfs -> snapper (antes/despues de cada pacman y en
# el menu de GRUB); ext4 -> Timeshift
snapper
snap-pac
grub-btrfs
inotify-tools
btrfs-assistant
timeshift
# Fuentes para todos los idiomas (sin ellas el chino, japones o arabe son cuadros)
noto-fonts
# Métricas de Calibri y Cambria: los .docx de clase no se descolocan (Ubuntu/Fedora las traen)
ttf-carlito
ttf-caladea
noto-fonts-cjk
# Carpetas Documentos, Descargas, Imagenes... en el idioma del sistema
xdg-user-dirs
# VPN y modems moviles
networkmanager-openvpn
networkmanager-openconnect
wireguard-tools
modemmanager
usb_modeswitch
# Codecs que faltaban (GStreamer: AAC, H.264 por libav, MP3...)
gst-libav
gst-plugins-ugly
# Arranque seguro (Secure Boot) con claves propias: titan-arranque-seguro
sbctl
# Animacion de arranque (sistema instalado)
plymouth
# Accesibilidad: lector de pantalla y sintesis de voz en espanol
orca
speech-dispatcher
espeak-ng
# Metodos de entrada (chino, japones, coreano...): se activan en Ajustes > Teclado
fcitx5
fcitx5-qt
fcitx5-gtk
fcitx5-configtool
fcitx5-chinese-addons
fcitx5-mozc
fcitx5-hangul
# Corrector ortografico (Firefox, OnlyOffice, GTK)
hunspell
hunspell-es_any
hunspell-en_us
# Lector de huellas y Thunderbolt
fprintd
bolt
# Aviso de actualizaciones (checkupdates)
pacman-contrib
fakeroot
# --- Lo que Ubuntu y Fedora traen de serie y faltaba (comparacion 2026-11) ---
# Editor de texto grafico (los .txt se abrian en vim dentro de una terminal)
gnome-text-editor
# Comprimir y extraer: el Finder lo hace con bsdtar/7z; File Roller abre los
# .zip/.7z/.rar para ver lo que hay dentro, como en Ubuntu
zip
7zip
unrar
file-roller
# Monitor del sistema (procesos, CPU, memoria, discos)
# Particionar a mano (boton "Abrir GParted" del instalador). Corre como root
# por XWayland: necesita xhost para dar permiso a root en la pantalla
gparted
xorg-xhost
# Grabar la pantalla (titan-grabar, Super+Shift+5) y teclado en pantalla
# (titan-teclado escribe con wtype por el protocolo de teclado virtual)
wf-recorder
# AppArmor (como Ubuntu): el kernel lo trae; se activa con lsm= en el arranque
apparmor

# Apps para estudiar y dar clase (2026-11). Veyon, Epoptes y Gromit-MPX no
# estan en los repos (solo AUR); Gromit-MPX se instala desde la App Store.
# Pizarra y anotaciones
openboard
xournalpp
# Oficina y PDF (ONLYOFFICE va aparte: build-iso.sh descarga su AppImage)
libreoffice-fresh
libreoffice-fresh-es
pdfarranger
# Grabar y editar video de clases
obs-studio
kdenlive
# Examenes, notas y libros
auto-multiple-choice
joplin-desktop
obsidian
anki
calibre
# Ciencias y matematicas (KDE Edu), astronomia e infantil
kalzium
kstars
kmplot
kig
geogebra
stellarium
gcompris-qt

# Impresoras antiguas (las modernas imprimen sin driver, IPP Everywhere):
# Epson/Canon/Brother con gutenprint y foomatic, HP con hplip (como Ubuntu)
gutenprint
foomatic-db
foomatic-db-engine
foomatic-db-ppds
hplip
# "Abrir con la grafica dedicada" en portatiles con dos GPU
switcheroo-control
# Mejor integracion como maquina virtual en QEMU/KVM (arranca solo por udev)
qemu-guest-agent
