[Desktop Entry]
Name=Música
Comment=Reproductor de música para TITAN Linux
Exec=titan-musica %F
Icon=/usr/share/titan/icons/music.png
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Player;Qt;
MimeType=audio/mpeg;audio/ogg;audio/flac;audio/x-wav;audio/wav;audio/aac;audio/mp4;audio/x-m4a;audio/opus;audio/x-opus+ogg;audio/x-vorbis+ogg;

