#!/bin/sh
# Inti OS - instaladores de Ubuntu/Debian (.deb) y Fedora (.rpm) con doble clic.
#
# Inti no usa dpkg ni rpm, así que no se instalan "a la Ubuntu". Al abrir uno:
#   1. Se LEE sin ejecutar nada: nombre, descripción e icono.
#   2. Si el programa está en la App Store (Flathub) se recomienda instalarlo
#      desde ahí: se actualiza solo y está pensado para cualquier sistema.
#   3. "Instalar de todos modos": se desempaqueta SOLO en la cuenta
#      (~/.local/share/inti-paquetes/<id>), sale en el menú de inicio y se
#      quita con clic derecho > Desinstalar. Sin contraseña y sin tocar el
#      sistema: NUNCA se ejecutan los scripts de instalación del paquete
#      (en Ubuntu corren como administrador). Antes se mira si le faltan
#      librerías y se avisa.
#
# Uso: titan-paquete FICHERO.deb|FICHERO.rpm     (lo que lanza el doble clic)
#      titan-paquete quitar FICHERO.desktop       (Desinstalar del menú de inicio)
set -u
datos="${XDG_DATA_HOME:-$HOME/.local/share}"
base="$datos/inti-paquetes"
apps="$datos/applications"
pregunta=/usr/share/titan/paquete/Pregunta.qml
ldso=/usr/lib/ld-linux-x86-64.so.2

avisar() { command -v notify-send >/dev/null 2>&1 && notify-send -a "Inti" -i "${3:-system-software-install}" "$1" "$2"; }
clave() { sed -n '/^\[Desktop Entry\]/,/^\[/p' "$1" 2>/dev/null | sed -n "s/^$2=//p" | head -n 1 | tr -d '\r\n'; }
limpio() { printf '%s' "$1" | tr -d '\n\r' | sed 's/[;]*$//'; }

# ------------------------------------------------------------------ quitar
if [ "${1:-}" = quitar ]; then
    d="${2:-}"
    case "$d" in "$apps"/inti-paquete-*.desktop) ;; *) echo "no es un paquete instalado por Inti" >&2; exit 1 ;; esac
    [ -f "$d" ] || exit 1
    dir=$(clave "$d" X-Inti-Paquete)
    case "$dir" in
        "$base"/?*) case "$dir" in */..*|*/../*) exit 1 ;; esac
                    # Todos sus lanzadores (un paquete puede traer varios)
                    grep -lsx "X-Inti-Paquete=$dir" "$apps"/inti-paquete-*.desktop | while read -r l; do rm -f -- "$l"; done
                    rm -rf -- "$dir" ;;
        *) rm -f -- "$d" ;;
    esac
    /usr/local/bin/titan-shell --recargar-apps >/dev/null 2>&1
    exit 0
fi

# ------------------------------------------------------------------ abrir
f="${1:-}"
[ -n "$f" ] || { echo "uso: titan-paquete FICHERO.deb|.rpm" >&2; exit 2; }
case "$f" in file://*) f=$(printf '%s' "${f#file://}" | sed 's/%20/ /g') ;; esac
f=$(realpath -e -- "$f" 2>/dev/null) || { avisar "No se encuentra el archivo" "$1" dialog-error; exit 1; }
fichero=$(basename "$f")

# Tipo por su contenido, no por la extensión
if [ "$(head -c 21 "$f" 2>/dev/null | tr -d '\000')" = "$(printf '!<arch>\ndebian-binary')" ]; then
    tipo=deb
elif [ "$(od -An -tx1 -N4 "$f" 2>/dev/null | tr -d ' \n')" = "edabeedb" ]; then
    tipo=rpm
else
    avisar "No es un instalador válido" "$fichero no es un paquete .deb ni .rpm." dialog-error
    exit 1
fi

tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/x"

# Desempaqueta los ficheros del programa (sin ejecutar nada) en $1
desempaquetar() {
    if [ "$tipo" = deb ]; then
        datos_tar=$(bsdtar -tf "$f" 2>/dev/null | grep -m1 '^data\.tar') || return 1
        bsdtar -xOf "$f" "$datos_tar" | bsdtar -xf - -C "$1" --no-same-owner 2>/dev/null
    else
        bsdtar -xf "$f" -C "$1" --no-same-owner 2>/dev/null
    fi
}

# Para preguntar basta con los lanzadores y los iconos
if [ "$tipo" = deb ]; then
    datos_tar=$(bsdtar -tf "$f" 2>/dev/null | grep -m1 '^data\.tar')
    ctl_tar=$(bsdtar -tf "$f" 2>/dev/null | grep -m1 '^control\.tar')
    bsdtar -xOf "$f" "$datos_tar" 2>/dev/null | bsdtar -xf - -C "$tmp/x" --no-same-owner \
        '*.desktop' '*/icons/*' '*/pixmaps/*' 2>/dev/null
    control=$(bsdtar -xOf "$f" "$ctl_tar" 2>/dev/null | bsdtar -xOf - './control' 'control' 2>/dev/null)
    paquete=$(printf '%s\n' "$control" | sed -n 's/^Package: *//p' | head -n 1)
    resumen=$(printf '%s\n' "$control" | sed -n 's/^Description: *//p' | head -n 1)
else
    bsdtar -xf "$f" -C "$tmp/x" --no-same-owner '*.desktop' '*/icons/*' '*/pixmaps/*' 2>/dev/null
    paquete=$(printf '%s' "$fichero" | sed -E 's/\.rpm$//; s/[-_.](x86_64|noarch|aarch64|i686)$//; s/-[0-9].*$//')
    resumen=""
fi

# El lanzador principal: el primero que se ve en el menú
lanzador=""
find "$tmp/x" -path '*/share/applications/*.desktop' -type f 2>/dev/null | sort > "$tmp/lanzadores"
while IFS= read -r d; do
    [ "$(clave "$d" NoDisplay)" = true ] && continue
    [ "$(clave "$d" Type)" = Application ] || continue
    lanzador="$d"; break
done < "$tmp/lanzadores"
nombre=""; icono_n=""; comentario="$resumen"; categorias=""
if [ -n "$lanzador" ]; then
    nombre=$(clave "$lanzador" 'Name\[es\]'); [ -n "$nombre" ] || nombre=$(clave "$lanzador" Name)
    icono_n=$(clave "$lanzador" Icon)
    c=$(clave "$lanzador" 'Comment\[es\]'); [ -n "$c" ] || c=$(clave "$lanzador" Comment); [ -n "$c" ] && comentario="$c"
    categorias=$(clave "$lanzador" Categories)
fi
[ -n "$nombre" ] || nombre=$(printf '%s' "${paquete:-$fichero}" | sed 's/[-_]/ /g')

# Icono: el PNG más grande (o un SVG) con ese nombre, dentro del paquete
icono_de() {
    raiz="$1"; n="$2"
    case "$n" in /*) [ -f "$raiz$n" ] && { echo "$raiz$n"; return 0; } ; n=$(basename "$n" | sed 's/\.[^.]*$//') ;; esac
    [ -n "$n" ] || return 1
    mejor=$(find "$raiz" \( -name "$n.png" -o -name "$n.svg" \) -type f 2>/dev/null |
        awk '{ t = 0; if (match($0, /[0-9]+x[0-9]+/)) t = substr($0, RSTART, RLENGTH) + 0; if ($0 ~ /\.svg$/) t = 999; print t "\t" $0 }' |
        sort -n | tail -n 1 | cut -f2-)
    [ -n "$mejor" ] && echo "$mejor"
}
icono=$(icono_de "$tmp/x" "$icono_n") || icono=""

# ¿Está en la App Store? (búsqueda local de Flathub, sin enviar nada)
tienda_id=""; tienda_nombre=""
if command -v flatpak >/dev/null 2>&1; then
    norm() { printf '%s' "$1" | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9]//g'; }
    buscado=$(norm "$nombre"); buscado_p=$(norm "${paquete:-}")
    resultados=$(timeout 20 flatpak search --columns=application,name "$nombre" 2>/dev/null)
    [ -n "$resultados" ] || resultados=$(timeout 20 flatpak search --columns=application,name "${paquete:-$nombre}" 2>/dev/null)
    while IFS="$(printf '\t')" read -r id n; do
        [ -n "$id" ] || continue
        nn=$(norm "$n")
        [ ${#nn} -ge 3 ] || continue
        if [ "$nn" = "$buscado" ] || [ "$nn" = "$buscado_p" ]; then
            tienda_id="$id"; tienda_nombre="$n"; break
        fi
    done <<EOF
$resultados
EOF
fi

# Tema de Inti para la ventana
tema="${XDG_CONFIG_HOME:-$HOME/.config}/titan/theme.conf"
oscuro=$(sed -n 's/^isDark=//p' "$tema" 2>/dev/null | tail -n 1)
acento=$(sed -n 's/^accent=//p' "$tema" 2>/dev/null | tail -n 1 | tr -d '"')
printf '%s' "$acento" | grep -Eq '^#[0-9a-fA-F]{6}$' || acento="#0071e3"
qml=$(command -v qml6 || echo /usr/lib/qt6/bin/qml)
QT_QUICK_CONTROLS_STYLE=Basic "$qml" "$pregunta" -- "$nombre" "$icono" "${oscuro:-false}" "$acento" \
    "$tipo" "$tienda_nombre" "$(limpio "$comentario")" >/dev/null 2>&1
respuesta=$?

case "$respuesta" in
    12) if [ -n "$tienda_id" ]; then exec /usr/local/bin/plasma-discover "appstream://$tienda_id"
        else exec /usr/local/bin/plasma-discover --search "$nombre"; fi ;;
    10) ;;
    *) exit 0 ;;
esac

# ------------------------------------------------------------------ instalar en la cuenta
id=$(printf '%s' "${paquete:-$nombre}" | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9]\{1,\}/-/g; s/^-//; s/-$//')
[ -n "$id" ] || id="programa"
dest="$base/$id"
avisar "Instalando $nombre" "Se instala solo en tu cuenta; no hace falta la contraseña." "${icono:-system-software-install}"

nuevo="$base/.$id.nuevo"
rm -rf -- "$nuevo"; mkdir -p "$nuevo"
if ! desempaquetar "$nuevo"; then
    rm -rf -- "$nuevo"
    avisar "No se pudo instalar $nombre" "El archivo está dañado o incompleto. Vuelve a descargarlo." dialog-error
    exit 1
fi
# Nada con permisos especiales (setuid) ni enlaces que salgan de su carpeta
find "$nuevo" -type f -perm /6000 -exec chmod ug-s {} + 2>/dev/null
# La versión nueva sustituye a la anterior (actualizar = abrir el .deb nuevo)
rm -rf -- "$dest"
mv -- "$nuevo" "$dest"

# Rutas del paquete (/opt/x, /usr/bin/x) dentro de su carpeta
dentro() {
    p="$1"
    case "$p" in
        /*) r="$dest$p" ;;
        *)  r=""
            for c in usr/bin usr/local/bin bin usr/games; do [ -e "$dest/$c/$p" ] && { r="$dest/$c/$p"; break; }; done ;;
    esac
    [ -n "$r" ] || return 1
    # Enlaces absolutos (/usr/bin/opera -> /opt/opera/opera): dentro también
    i=0
    while [ -L "$r" ] && [ $i -lt 8 ]; do
        t=$(readlink "$r")
        case "$t" in /*) r="$dest$t" ;; *) r="$(dirname "$r")/$t" ;; esac
        i=$((i + 1))
    done
    [ -f "$r" ] && echo "$r"
}

libs="$dest/usr/lib:$dest/usr/lib64:$dest/usr/lib/x86_64-linux-gnu:$dest/lib:$dest/lib/x86_64-linux-gnu"
mkdir -p "$apps"
grep -lsx "X-Inti-Paquete=$dest" "$apps"/inti-paquete-*.desktop | while read -r l; do rm -f -- "$l"; done
faltan=""
creados=0
primero=""
find "$dest" -path '*/share/applications/*.desktop' -type f 2>/dev/null | sort > "$tmp/todos"
while IFS= read -r d; do
    [ "$(clave "$d" NoDisplay)" = true ] && continue
    [ "$(clave "$d" Type)" = Application ] || continue
    exec_l=$(clave "$d" Exec)
    prog=$(printf '%s' "$exec_l" | sed -E 's/^env( +[A-Za-z_]+=[^ ]*)* +//' | awk '{print $1}' | tr -d '"')
    resto=$(printf '%s' "$exec_l" | sed -E 's/^env( +[A-Za-z_]+=[^ ]*)* +//' | cut -s -d' ' -f2-)
    real=$(dentro "$prog") || continue
    chmod u+x "$real" 2>/dev/null
    # ¿Le falta alguna librería? (ld.so --list solo lee el binario, no lo ejecuta)
    if [ -x "$ldso" ] && [ "$(od -An -c -N4 "$real" 2>/dev/null | tr -d ' ')" = '177ELF' ]; then
        f_l=$(LD_LIBRARY_PATH="$libs:$(dirname "$real")" "$ldso" --list "$real" 2>/dev/null | awk '/not found/ {print $1}')
        [ -n "$f_l" ] && faltan="$faltan $f_l"
    fi
    sub=$(basename "$d" .desktop | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9]\{1,\}/-/g')
    abrir="$dest/.inti-abrir-$sub"
    {
        echo '#!/bin/sh'
        echo "# Inti: abre $(limpio "$(clave "$d" Name)") con sus propias librerías"
        echo "export LD_LIBRARY_PATH=\"$libs:$(dirname "$real")\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}\""
        echo "export PATH=\"$dest/usr/bin:\$PATH\""
        echo "exec \"$real\" \"\$@\""
    } > "$abrir"
    chmod 755 "$abrir"
    n=$(clave "$d" 'Name\[es\]'); [ -n "$n" ] || n=$(clave "$d" Name)
    c=$(clave "$d" 'Comment\[es\]'); [ -n "$c" ] || c=$(clave "$d" Comment)
    ic=$(icono_de "$dest" "$(clave "$d" Icon)") || ic="application-x-executable"
    # Los argumentos del Exec original (%U, %F...) se conservan
    args=$(printf '%s' "$resto" | sed 's/"/\\"/g')
    {
        echo "[Desktop Entry]"
        echo "Type=Application"
        echo "Name=$(limpio "$n")"
        [ -n "$c" ] && echo "Comment=$(limpio "$c")"
        echo "Exec=\"$abrir\"${args:+ $args}"
        echo "Icon=$ic"
        mt=$(clave "$d" MimeType); [ -n "$mt" ] && echo "MimeType=$mt"
        echo "Categories=$(limpio "$(clave "$d" Categories)");"
        sw=$(clave "$d" StartupWMClass); [ -n "$sw" ] && echo "StartupWMClass=$sw"
        echo "Terminal=false"
        echo "X-Inti-Paquete=$dest"
    } > "$apps/inti-paquete-$id-$sub.desktop"
    chmod 644 "$apps/inti-paquete-$id-$sub.desktop"
    creados=$((creados + 1))
    [ "$creados" -eq 1 ] && primero="$abrir"
done < "$tmp/todos"

if [ "$creados" -eq 0 ]; then
    rm -rf -- "$dest"
    avisar "No se pudo instalar $nombre" "Este paquete no trae ningún programa que abrir (puede ser un controlador o una parte del sistema)." dialog-error
    exit 1
fi

/usr/local/bin/titan-shell --recargar-apps >/dev/null 2>&1
if [ -n "$faltan" ]; then
    lista=$(printf '%s\n' $faltan | sort -u | head -n 4 | tr '\n' ' ')
    avisar "$nombre instalado, pero puede que no funcione" "Le faltan piezas que Inti no trae: $lista. Busca el programa en la App Store." dialog-warning
else
    avisar "$nombre instalado" "Ya está en el menú de inicio. Para quitarlo: clic derecho > Desinstalar. No se actualiza solo: para actualizar, abre el instalador nuevo." "${ic:-system-software-install}"
fi
setsid -f "$primero" >/dev/null 2>&1 < /dev/null
exit 0
