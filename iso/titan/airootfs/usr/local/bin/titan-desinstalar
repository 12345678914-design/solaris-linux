#!/bin/sh
# Inti OS - desinstalar una app desde el menu de inicio (clic derecho >
# Desinstalar). titan-shell lo llama con pkexec: polkit pide la contrasena
# de administrador en ventana ("Por tu seguridad...").
#
# Por seguridad solo acepta paquetes que:
#   - esten instalados y tengan nombre de paquete valido;
#   - sean apps (tienen un .desktop en /usr/share/applications);
#   - no sean parte del sistema (Inti, nucleo, escritorio, sonido, red...).
# Si otro programa necesita el paquete, pacman se niega y no se quita nada.
#
#   titan-desinstalar PAQUETE        (root, con pkexec)
#   titan-desinstalar --puede PAQUETE  si | no  (sin root: para el menu)
set -u
export LC_ALL=C

protegido() {
    case "$1" in
        inti-*|linux|linux-*|base|base-devel|systemd*|pacman*|glibc|sudo|polkit*|dbus*|\
        greetd*|gtklock*|cage|wayfire*|wf-*|labwc|plasma-discover*|discover|\
        xdg-desktop-portal*|pipewire*|wireplumber|networkmanager*|mesa*|vulkan-*|\
        qt6-*|qt5-*|gtk3|gtk4|glib2|kitty|flatpak|bluez*|cups*|grub|efibootmgr|\
        mkinitcpio*|xorg-*|wlroots*|fcitx5*|archlinux-keyring|ca-certificates*)
            return 0 ;;
    esac
    return 1
}

valido() {
    case "$1" in ''|-*|*[!a-z0-9@._+-]*) return 1 ;; esac
    pacman -Qq "$1" >/dev/null 2>&1 || return 1
    pacman -Qlq "$1" 2>/dev/null | grep -q '^/usr/share/applications/[^/]*\.desktop$' || return 1
    protegido "$1" && return 1
    return 0
}

if [ "${1:-}" = --puede ]; then
    if valido "${2:-}"; then echo si; else echo no; fi
    exit 0
fi

paquete=${1:-}
[ "$(id -u)" -eq 0 ] || { echo "Hace falta ser administrador" >&2; exit 1; }
if [ -d /run/archiso ]; then
    echo "En la sesión de prueba no se desinstalan programas." >&2
    exit 3
fi
valido "$paquete" || { echo "Ese programa es parte del sistema o no se puede desinstalar." >&2; exit 2; }
if pgrep -x pacman >/dev/null 2>&1; then
    echo "Ya se está instalando o quitando algo. Espera a que termine." >&2
    exit 4
fi
salida=$(pacman -Rs --noconfirm "$paquete" 2>&1) || {
    if printf '%s' "$salida" | grep -q 'breaks dependency\|required by'; then
        echo "Otro programa lo necesita, así que no se ha quitado." >&2
    else
        echo "No se pudo desinstalar." >&2
    fi
    exit 5
}
exit 0
