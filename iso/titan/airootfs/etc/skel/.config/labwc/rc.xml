<?xml version="1.0"?>
<labwc_config>
  <theme>
    <name>Titan-macOS</name>
    <cornerRadius>16</cornerRadius>
    <titlebar>
      <!-- Layout macOS: Cerrar, Minimizar, Maximizar a la izquierda; nada a la derecha -->
      <layout>close,iconify,max:</layout>
    </titlebar>
    <font place="ActiveWindow">
      <name>Inter</name>
      <size>10</size>
      <weight>bold</weight>
    </font>
    <font place="InactiveWindow">
      <name>Inter</name>
      <size>10</size>
      <weight>normal</weight>
    </font>
  </theme>

  <windowSwitcher show="yes" preview="yes" outline="yes" />

  <!-- Reglas de ventana: las apps de Titan con CSD propio no llevan barra de labwc; Acerca sí usa gestor de ventana -->
  <windowRules>
    <windowRule identifier="*" serverDecoration="default" />
    <windowRule identifier="titan-finder" serverDecoration="no" />
    <windowRule identifier="titan-fotos" serverDecoration="no" />
    <windowRule identifier="titan-musica" serverDecoration="no" />
    <windowRule identifier="titan-terminal" serverDecoration="no" />
    <windowRule identifier="titan-settings" serverDecoration="no" />
    <windowRule identifier="titan-shell" serverDecoration="no" />
    <windowRule identifier="titan-desktop" serverDecoration="no" />
    <windowRule title="*Explorador de archivos*" serverDecoration="no" />
    <windowRule identifier="titan-monitor" serverDecoration="no" />
    <windowRule title="*Fotos*" serverDecoration="no" />
    <windowRule title="*Música*" serverDecoration="no" />
    <windowRule title="*Terminal*" serverDecoration="no" />
    <windowRule title="*Ajustes del Sistema*" serverDecoration="no" />
    <windowRule identifier="titan-acerca" serverDecoration="yes" />
    <windowRule title="*Acerca*" serverDecoration="yes" />
    <windowRule identifier="firefox*" serverDecoration="yes" />
    <windowRule title="*Firefox*" serverDecoration="yes" />
    <windowRule identifier="*onlyoffice*" serverDecoration="yes" />
    <windowRule identifier="DesktopEditors*" serverDecoration="yes" />
    <windowRule title="*ONLYOFFICE*" serverDecoration="yes" />
    <windowRule title="*DesktopEditors*" serverDecoration="yes" />

    <!-- Delimitar tamaño y centrar ventanas de diálogo y guardado para que los botones sean siempre accesibles -->
    <windowRule type="dialog">
      <action name="ResizeTo" width="760" height="480" />
    </windowRule>
    <windowRule type="utility">
      <action name="ResizeTo" width="760" height="480" />
    </windowRule>
    <windowRule title="*Guardar*">
      <action name="ResizeTo" width="760" height="480" />
    </windowRule>
    <windowRule title="*Save*">
      <action name="ResizeTo" width="760" height="480" />
    </windowRule>
    <windowRule title="*Abrir*">
      <action name="ResizeTo" width="760" height="480" />
    </windowRule>
    <windowRule title="*Open*">
      <action name="ResizeTo" width="760" height="480" />
    </windowRule>
    <windowRule title="*Chooser*">
      <action name="ResizeTo" width="760" height="480" />
    </windowRule>
  </windowRules>

  <!-- Centrado automático de ventanas para evitar que queden fuera de la pantalla -->
  <placement>
    <policy>center</policy>
  </placement>

  <!-- Suavizado de bordes, resistencia y ajuste suave estilo macOS -->
  <resistance>
    <strength>12</strength>
    <screen_edge>18</screen_edge>
  </resistance>

  <snapping>
    <range inner="10" outer="10" />
  </snapping>

  <!-- Atajos de ratón estilo macOS -->
  <mouse>
    <default/>
    <context name="Titlebar">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Left" action="Drag">
        <action name="Move"/>
      </mousebind>
      <mousebind button="Left" action="DoubleClick">
        <action name="ToggleMaximize"/>
      </mousebind>
    </context>
    <context name="Frame">
      <mousebind button="A-Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="A-Left" action="Drag">
        <action name="Move"/>
      </mousebind>
      <mousebind button="A-Right" action="Drag">
        <action name="Resize"/>
      </mousebind>
    </context>
    <context name="Client">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
    </context>
  </mouse>

  <!-- Espacios de trabajo (Desktops / Workspaces) -->
  <desktops number="8">
    <popupTime>0</popupTime>
    <names>
      <name>Escritorio 1</name>
      <name>Escritorio 2</name>
      <name>Escritorio 3</name>
      <name>Escritorio 4</name>
      <name>Escritorio 5</name>
      <name>Escritorio 6</name>
      <name>Escritorio 7</name>
      <name>Escritorio 8</name>
    </names>
  </desktops>

  <!-- Atajos de teclado estilo macOS -->
  <keyboard>
    <default/>
    
    <!-- Espacios de trabajo: Super + 1..8 y Super + Arriba (Mission Control) -->
    <keybind key="W-1"><action name="GoToDesktop" to="1" /></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2" /></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3" /></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4" /></keybind>
    <keybind key="W-5"><action name="GoToDesktop" to="5" /></keybind>
    <keybind key="W-6"><action name="GoToDesktop" to="6" /></keybind>
    <keybind key="W-7"><action name="GoToDesktop" to="7" /></keybind>
    <keybind key="W-8"><action name="GoToDesktop" to="8" /></keybind>
    <!-- Win+Mayús+número: la ventana al escritorio N, sin seguirla -->
    <keybind key="W-S-1"><action name="SendToDesktop" to="1" follow="no" /></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop" to="2" follow="no" /></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop" to="3" follow="no" /></keybind>
    <keybind key="W-S-4"><action name="SendToDesktop" to="4" follow="no" /></keybind>
    <keybind key="W-S-5"><action name="SendToDesktop" to="5" follow="no" /></keybind>
    <keybind key="W-S-6"><action name="SendToDesktop" to="6" follow="no" /></keybind>
    <keybind key="W-S-7"><action name="SendToDesktop" to="7" follow="no" /></keybind>
    <keybind key="W-S-8"><action name="SendToDesktop" to="8" follow="no" /></keybind>
    <keybind key="W-Up"><action name="Execute" command="titan-shell --toggle-workspaces" /></keybind>
    
    <!-- Tecla Mod / Super suelta (al pulsar y soltar): abre el menú de inicio / Launchpad -->
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="titan-shell --toggle-launcher"/>
    </keybind>
    <keybind key="Super_R" onRelease="yes">
      <action name="Execute" command="titan-shell --toggle-launcher"/>
    </keybind>

    <!-- Super/Cmd + Espacio: Lanzador / Spotlight -->
    <keybind key="W-space">
      <action name="Execute" command="titan-shell --toggle-launcher"/>
    </keybind>
    
    <!-- Super/Cmd + T: Terminal -->
    <keybind key="W-t">
      <action name="Execute" command="titan-terminal"/>
    </keybind>

    <!-- Ctrl + W: Selector de fondo de pantalla estilo macOS -->
    <keybind key="C-w">
      <action name="Execute" command="titan-shell --toggle-wallpaper"/>
    </keybind>
    <keybind key="C-W">
      <action name="Execute" command="titan-shell --toggle-wallpaper"/>
    </keybind>

    <!-- Super/Mod + W: Selector de fondo de pantalla estilo macOS -->
    <keybind key="W-w">
      <action name="Execute" command="titan-shell --toggle-wallpaper"/>
    </keybind>
    <keybind key="W-W">
      <action name="Execute" command="titan-shell --toggle-wallpaper"/>
    </keybind>

    <!-- Super/Mod + Shift + D: Alternar Modo Claro / Oscuro -->
    <keybind key="W-S-d">
      <action name="Execute" command="titan-shell --toggle-theme"/>
    </keybind>
    <keybind key="W-S-D">
      <action name="Execute" command="titan-shell --toggle-theme"/>
    </keybind>
    
    <!-- Como Windows: Ctrl+Alt+Supr, Win+I (Ajustes), Win+V (portapapeles),
         Win+. (emojis), Win+F1 (atajos). Alt+F4 ya viene con <default/>. -->
    <keybind key="C-A-Delete"><action name="Execute" command="titan-shell --tecla seguridad"/></keybind>
    <keybind key="W-i"><action name="Execute" command="titan-shell --tecla ajustes"/></keybind>
    <keybind key="W-v"><action name="Execute" command="titan-shell --tecla portapapeles"/></keybind>
    <keybind key="W-period"><action name="Execute" command="titan-shell --tecla emojis"/></keybind>
    <keybind key="W-F1"><action name="Execute" command="titan-shell --tecla atajos"/></keybind>
    <keybind key="W-x"><action name="Execute" command="titan-shell --tecla herramientas"/></keybind>
    <keybind key="W-p"><action name="Execute" command="titan-shell --tecla proyectar"/></keybind>
    <!-- Ctrl+Mayús+Esc: Monitor de recursos (como el Administrador de tareas de Windows) -->
    <keybind key="C-S-Escape">
      <action name="Execute" command="titan-monitor"/>
    </keybind>
    <!-- Super/Mod + E: Explorador de archivos -->
    <keybind key="W-e">
      <action name="Execute" command="titan-finder"/>
    </keybind>
    <keybind key="W-E">
      <action name="Execute" command="titan-finder"/>
    </keybind>
    
    <!-- Super/Cmd + Q: Cerrar ventana -->
    <keybind key="W-q">
      <action name="Close"/>
    </keybind>
    
    <!-- Super/Cmd + M: Minimizar ventana al Dock -->
    <keybind key="W-m">
      <action name="Iconify"/>
    </keybind>
    
    <!-- Super/Cmd + F: Maximizar ventana (zoom) -->
    <keybind key="W-f">
      <action name="ToggleMaximize"/>
    </keybind>
    
    <!-- Super/Cmd + L: Bloquear pantalla (Lock Screen) -->
    <keybind key="W-l">
      <action name="Execute" command="titan-bloquear"/>
    </keybind>
    <keybind key="W-L">
      <action name="Execute" command="titan-bloquear"/>
    </keybind>

    <!-- Capturas de pantalla (titan-captura): Impr Pant y Super+Shift+S -->
    <keybind key="Print"><action name="Execute" command="titan-captura pantalla"/></keybind>
    <keybind key="S-Print"><action name="Execute" command="titan-captura area"/></keybind>
    <keybind key="W-S-s"><action name="Execute" command="titan-captura area"/></keybind>
    <keybind key="W-S-S"><action name="Execute" command="titan-captura area"/></keybind>
    <!-- Grabar la pantalla (titan-grabar): el mismo atajo para parar y guardar -->
    <keybind key="W-A-r"><action name="Execute" command="titan-grabar"/></keybind>
    <keybind key="W-A-S-r"><action name="Execute" command="titan-grabar area"/></keybind>

    <!-- Lector de pantalla (Orca), como en GNOME -->
    <keybind key="W-A-s"><action name="Execute" command="titan-lector"/></keybind>

    <!-- Teclas especiales (volumen, brillo, multimedia...): titan-shell -tecla
         las hace y muestra el nivel en la Isla Dinamica -->
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="titan-shell --tecla volumen-subir"/></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="titan-shell --tecla volumen-bajar"/></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="titan-shell --tecla silenciar"/></keybind>
    <keybind key="XF86AudioMicMute"><action name="Execute" command="titan-shell --tecla micro-silenciar"/></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="titan-shell --tecla brillo-subir"/></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="titan-shell --tecla brillo-bajar"/></keybind>
    <keybind key="XF86KbdBrightnessUp"><action name="Execute" command="titan-shell --tecla teclado-subir"/></keybind>
    <keybind key="XF86KbdBrightnessDown"><action name="Execute" command="titan-shell --tecla teclado-bajar"/></keybind>
    <keybind key="XF86KbdLightOnOff"><action name="Execute" command="titan-shell --tecla teclado-alternar"/></keybind>
    <keybind key="XF86AudioPlay"><action name="Execute" command="titan-shell --tecla reproducir"/></keybind>
    <keybind key="XF86AudioPause"><action name="Execute" command="titan-shell --tecla pausa"/></keybind>
    <keybind key="XF86AudioNext"><action name="Execute" command="titan-shell --tecla siguiente"/></keybind>
    <keybind key="XF86AudioPrev"><action name="Execute" command="titan-shell --tecla anterior"/></keybind>
    <keybind key="XF86AudioStop"><action name="Execute" command="titan-shell --tecla parar"/></keybind>
    <keybind key="XF86Calculator"><action name="Execute" command="titan-shell --tecla calculadora"/></keybind>
    <keybind key="XF86WWW"><action name="Execute" command="titan-shell --tecla navegador"/></keybind>
    <keybind key="XF86Mail"><action name="Execute" command="titan-shell --tecla correo"/></keybind>
    <keybind key="XF86Tools"><action name="Execute" command="titan-shell --tecla ajustes"/></keybind>
    <keybind key="XF86Search"><action name="Execute" command="titan-shell --tecla buscar"/></keybind>
    <keybind key="XF86ScreenSaver"><action name="Execute" command="titan-shell --tecla bloquear"/></keybind>
    <keybind key="XF86Display"><action name="Execute" command="titan-shell --tecla pantallas"/></keybind>
    <keybind key="W-d"><action name="Execute" command="titan-shell --tecla escritorio"/></keybind>
    
    <!-- Alt + Tab: Cambiar entre ventanas abiertas con estilo Liquid Glass -->
    <keybind key="A-Tab">
      <action name="NextWindow"/>
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow"/>
    </keybind>
  </keyboard>
</labwc_config>

