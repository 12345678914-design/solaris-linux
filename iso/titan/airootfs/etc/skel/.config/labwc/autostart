#!/bin/sh
# Solaris Linux - Autostart de sesion grafica con Labwc
export PATH="/usr/local/bin:$PATH"

# 0. Servidor de audio PipeWire y WirePlumber (Hardware real y emulado)
if command -v pipewire >/dev/null 2>&1; then
    pgrep -x pipewire >/dev/null 2>&1 || pipewire &
    sleep 0.3
    pgrep -x pipewire-pulse >/dev/null 2>&1 || pipewire-pulse &
    sleep 0.3
    pgrep -x wireplumber >/dev/null 2>&1 || wireplumber &
fi

# Desmutear y calibrar volumen en hardware real ALSA y PipeWire
(sleep 2 && /usr/local/bin/titan-audio-setup) &

# 0.1 Driver de sincronización de batería en QEMU
if [ -x /usr/local/bin/titan-battery-sync ]; then
    /usr/local/bin/titan-battery-sync &
fi

# 0.2 Desbloquear radio Wi-Fi en el arranque si existe hardware inalámbrico
(sleep 1 && rfkill unblock wifi 2>/dev/null && nmcli radio wifi on 2>/dev/null) &

# 1. Fondo de pantalla (capa LayerBackground) con autorecuperacion
lanzar_titan_desktop() {
    if [ -x /usr/local/bin/titan-desktop ] || command -v titan-desktop >/dev/null 2>&1; then
        /usr/local/bin/titan-desktop --escritorio >/tmp/titan-desktop.log 2>&1
        local ret=$?
        if [ $ret -ne 0 ]; then
            echo "Aviso: titan-desktop salio con codigo $ret. Reintentando con backend software..." >> /tmp/titan-desktop.log
            env -u __GLX_VENDOR_LIBRARY_NAME -u GBM_BACKEND QT_QUICK_BACKEND=software QSG_RHI_BACKEND=software LIBGL_ALWAYS_SOFTWARE=1 /usr/local/bin/titan-desktop --escritorio >>/tmp/titan-desktop.log 2>&1
        fi
    fi
}
(lanzar_titan_desktop) &

# 2. Solaris Shell (TopBar, Dock flotante, Iconos y Launchpad) con autorecuperacion
lanzar_titan_shell() {
    if [ -x /usr/local/bin/titan-shell ] || command -v titan-shell >/dev/null 2>&1; then
        /usr/local/bin/titan-shell >/tmp/titan-shell.log 2>&1
        local ret=$?
        if [ $ret -ne 0 ]; then
            echo "Aviso: titan-shell salio con codigo $ret. Reintentando con backend software..." >> /tmp/titan-shell.log
            env -u __GLX_VENDOR_LIBRARY_NAME -u GBM_BACKEND QT_QUICK_BACKEND=software QSG_RHI_BACKEND=software LIBGL_ALWAYS_SOFTWARE=1 /usr/local/bin/titan-shell >>/tmp/titan-shell.log 2>&1
        fi
    fi
}
(lanzar_titan_shell) &

# 3. Exportar variables de entorno en segundo plano para terminales y servicios
(
    sleep 1
    mkdir -p /tmp/.X11-unix 2>/dev/null || true
    chmod 1777 /tmp/.X11-unix 2>/dev/null || true
    if [ -n "$DISPLAY" ]; then
        echo "$DISPLAY" > /tmp/.titan-display
        chmod 0666 /tmp/.titan-display 2>/dev/null || true
    fi
    dbus-update-activation-environment --all 2>/dev/null || true
) &

