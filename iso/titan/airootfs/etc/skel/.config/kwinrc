[org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=Solaris-macOS
ButtonsOnLeft=XIA
ButtonsOnRight=
CloseOnDoubleClickOnMenu=false
ShowToolTips=true

[TabBox]
LayoutName=thumbnail_grid
ShowDesktop=false
ApplicationsMode=1

[Plugins]
blurEnabled=false
contrastEnabled=false
translucencyEnabled=false
slideEnabled=false
fadeEnabled=true
scaleEnabled=true

[Compositing]
AnimationSpeed=3
GLCore=true
HiddenPreviews=5
LatencyPolicy=Low
MaxFPS=60
RefreshRate=60
WindowsBlockCompositing=true

[Windows]
TitlebarDoubleClickCommand=Maximize
FocusPolicy=ClickToFocus
Placement=Centered

[KDE]
AnimationDurationFactor=0.6
