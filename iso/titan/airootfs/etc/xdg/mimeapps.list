# Inti OS: aplicaciones por defecto por tipo de archivo.
# Las apps propias (Fotos, Música, Vídeo, Finder) van primero; Celluloid queda
# como alternativa para vídeo en "Abrir con".
[Default Applications]
x-scheme-handler/mailto=org.mozilla.Thunderbird.desktop
message/rfc822=org.mozilla.Thunderbird.desktop
