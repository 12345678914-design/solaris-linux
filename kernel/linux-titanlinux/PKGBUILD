# Titan Linux kernel package
# Derived verbatim from Arch Linux's official 'linux-lts' packaging recipe.
# Upstream recipe: https://gitlab.archlinux.org/archlinux/packaging/packages/linux-lts
#
# Deltas from Arch (deliberately minimal, all verified against the upstream file):
#   1. pkgbase = linux-titanlinux. The '-titanlinux' suffix in the kernelrelease
#      comes for free from Arch's own localversion.20-pkgname mechanism
#      ("${pkgbase#linux}"), so no LOCALVERSION config change is needed.
#   2. pkgdesc rebranded to Titan Linux.
#   3. replaces=(wireguard-lts) removed. That conflict belongs to linux-lts;
#      a fork must not claim it or pacman would drop wireguard-lts from a
#      system that legitimately has linux-lts installed too.
#   4. NO conflicts=('linux-lts') on purpose. Titan Linux's kernel is meant to
#      coexist with Arch's linux-lts so that Arch's kernel remains available in
#      GRUB as a rescue entry if the custom one fails to boot.
#   5. config.x86_64 is Arch's config with CONFIG_LOCALVERSION_AUTO disabled.
#      Everything else is inherited from Arch on purpose: WERROR off (tolerates
#      new GCC warnings), IKCONFIG + IKCONFIG_PROC (config at /proc/config.gz),
#      PREEMPT_DYNAMIC with PREEMPT_NONE (throughput-oriented desktop kernel),
#      and MODVERSIONS *unset* so out-of-tree modules stay broadly compatible.
#   6. KBUILD_BUILD_HOST/USER rebranded (shows in `uname -v`).
#   7. b2sums_x86_64 removed because config.x86_64 was modified and its b2sum
#      is unknown. b2sums for the three patches is kept: those files are
#      byte-identical to Arch's. Run bump.sh to regenerate all checksums.
#
# Driver sources are NOT patched here. AMDGPU, i915, NVMe, USB and EXT4 all come
# straight from upstream LTS, and are updated by re-running kernel/bump.sh.
#
# Credits: kernel packaging recipe by Andreas Radke and the Arch Linux team,
# reused under the terms of the upstream file.

# Maintainer: Titan Linux <titan@titanos.local>

pkgbase=linux-titanlinux
pkgver=6.18.54
pkgrel=1
pkgdesc='Titan Linux kernel (LTS 6.18 track)'
url='https://www.kernel.org'
arch=(
  x86_64
)
makedepends=(
  bc
  binutils
  cpio
  gettext
  glibc
  libelf
  libgcc
  openssl
  pahole
  perl
  python
  rust
  rust-bindgen
  rust-src
  tar
  xxhash
  xz
  zlib
  zstd
)
# The htmldocs target needs a LaTeX/Sphinx toolchain (texlive-latexextra alone
# is several GB). TITAN_NO_HTMLDOCS=1 drops both the target and its dependencies,
# for hosts with a tight disk budget. The package is identical otherwise.
if [[ "${TITAN_NO_HTMLDOCS:-0}" != 1 ]]; then
  makedepends+=(
    graphviz
    imagemagick
    python-sphinx
    python-yaml
    texlive-latexextra
  )
fi
options=(
  !debug
  !strip
)
_srcname=linux-$pkgver
_srctag=v$pkgver
source=(
  https://cdn.kernel.org/pub/linux/kernel/v${pkgver%%.*}.x/${_srcname}.tar.{xz,sign}
  0001-add-sysctl-to-allow-disabling-unprivileged-CLONE_NEW.patch
  0002-drm-amdgpu-avoid-memory-allocation-in-the-critical-c.patch
  0003-drm-amdgpu-use-GFP_ATOMIC-instead-of-NOWAIT-in-the-c.patch
  0004-modfinal-strip-module-debug-info.patch
)
source_x86_64=(config.x86_64)
validpgpkeys=(
  ABAF11C65A2970B130ABE3C479BE3E4300411886  # Linus Torvalds
  647F28654894E3BD457199BE38DBBDC86092693E  # Greg Kroah-Hartman
)
