            '70d54dfde13e52ea1109c4222a987a29ada68feec35dca9ce4afd6f7977e8740'
            '44caa7c6a79055539f16ab118bece58934cdf93557643a50017634366c864b91'
            '25861f228d30a2d93e4f6327e5efc83d172f8d09a7a0c8668e7f732d691156b3')
# Arch's own config.x86_64 hash is aef082c1ee2484304a180fc6e8b320f7c93b27843a5deb74e1a92fe32d1dd86c
# Ours is that same file with CONFIG_LOCALVERSION_AUTO disabled, recomputed locally.
sha256sums_x86_64=('021ae8b89af12bab8f0dfd2ec77415a6badd6361f1b3ba0b8e4f218a0882cc1b')
b2sums=('8b86b9130a4847bb1188b0181922713afe367717560ad9faebc327feb911285a11a79309aaaebd705fac6eab7671986ac6726ec8aa44a11c686a2fdece638f3c'
        'SKIP'
