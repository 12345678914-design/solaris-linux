# Kernel build artifacts (produced by makepkg)
kernel/linux-titanlinux/src/
kernel/linux-titanlinux/pkg/
kernel/linux-titanlinux/*.pkg.tar.*
kernel/linux-titanlinux/*.install
kernel/linux-titanlinux/.BUILDINFO
kernel/linux-titanlinux/.MTREE
kernel/linux-titanlinux/.PKGINFO
# El arbol de fuentes del kernel y su tarball: se descargan y se descomprimen
# con kernel/bump.sh, son ~1.4 GB, y ademas el arbol tiene ficheros que solo se
# diferencian por mayusculas (xt_connmark.h / xt_CONNMARK.h), lo que hace que
# 'git add -A' se negue a anadir el resto con un 'fatal: will not add file
# alias'. No son fuente del proyecto.
kernel/linux-titanlinux/bsrc/
kernel/linux-titanlinux/linux-*.tar.xz
kernel/linux-titanlinux/linux-*.tar.sign
*.pkg.tar.*
*.iso

# Local package repository used by the ISO profile
repo/

# ISO build tree and outputs
out/
out_root/
run/
build/
# Imagenes ISO generadas y sus sumas de verificacion
*.iso
*.iso.sha256
# Archivos comprimidos del proyecto completo (no son fuente)
*.zip
titan-linux.zip

# verify/ NO se ignora: ahi viven los comprobadores, que son fuente del
# proyecto (comprobar-instalador.sh, comprobar-disco.sh, titan-verify.py) y no
# se pueden regenerar. Lo que se ignora es lo que sueltan al ejecutarse.
verify/*.log
verify/*.salida
verify/salidas/

# Files generated by scripts/build-iso.sh inside the archiso profile
iso/titan/airootfs/etc/titan-build.env
iso/titan/airootfs/usr/local/bin/*
# Scripts: son fuente, no se generan (los binarios de las apps si se ignoran).
!iso/titan/airootfs/usr/local/bin/titan-sesion
!iso/titan/airootfs/usr/local/bin/titan-bloquear
!iso/titan/airootfs/usr/local/bin/titan-bloquear-avisar
!iso/titan/airootfs/usr/local/bin/titan-inactividad
!iso/titan/airootfs/usr/local/bin/titan-captura
!iso/titan/airootfs/usr/local/bin/titan-grabar
!iso/titan/airootfs/usr/local/bin/plasma-discover
!iso/titan/airootfs/usr/local/bin/titan-elegir-pantalla
!iso/titan/airootfs/usr/local/bin/titan-cortafuegos
!iso/titan/airootfs/usr/local/bin/titan-actualizaciones
!iso/titan/airootfs/usr/local/bin/titan-arranque-seguro
!iso/titan/airootfs/usr/local/bin/titan-huella
!iso/titan/airootfs/usr/local/bin/titan-instantaneas
!iso/titan/airootfs/usr/local/bin/titan-lector
!iso/titan/airootfs/usr/local/bin/titan-pantallas
!iso/titan/airootfs/usr/local/bin/titan-luz-nocturna
!iso/titan/airootfs/usr/local/bin/titan-acento
!iso/titan/airootfs/usr/local/bin/titan-audio-setup
!iso/titan/airootfs/usr/local/bin/titan-battery-sync
!iso/titan/airootfs/usr/local/bin/prime-run
!iso/titan/airootfs/usr/local/bin/instalar
!iso/titan/airootfs/usr/local/bin/onlyoffice-desktopeditors
# Plugins de Wayfire compilados por scripts/build-wayfire-plugins.sh
iso/titan/airootfs/usr/lib/wayfire/*.so
apps/titan-fotos/build.old/
iso/titan/airootfs/etc/titan/base.conf
iso/titan/airootfs/etc/titan.old/
iso/titan/packages.local.*
iso/titan/pacman.conf.local
# El paquete del kernel que la ISO lleva en /titan-repo para que el instalador
# pueda ponerlo en el disco. Son ~160 MB de binario: no va al repositorio, se
# reconstruye con 'makepkg' en kernel/linux-titanlinux.
iso/titan/airootfs/titan-repo/

# OnlyOffice se integra descargando su AppImage (~400 MB); no es fuente.
iso/titan/airootfs/opt/onlyoffice/
iso/titan/airootfs/opt/onlyoffice/DesktopEditors.AppImage

# Binarios de las apps copiados al perfil de la ISO durante el build.
iso/titan/airootfs/usr/local_root/
iso/titan/airootfs/usr/local_root/bin/

# Qt / C++ / Apps build artifacts
apps/*/build/
apps/*/build.*/
apps/*/Makefile
apps/*/titan-acerca
apps/*/titan-calc
apps/*/titan-calendar
apps/*/titan-cli
apps/*/titan-clock
apps/*/titan-desktop
apps/*/titan-finder
apps/*/titan-fotos
apps/*/titan-installer
apps/*/titan-musica
apps/*/titan-panel
apps/*/titan-settings
apps/*/titan-shell
apps/*/titan-terminal
apps/*/titan-video
apps/*/*.o
apps/*/*.moc
apps/*/moc_*
apps/*/qrc_*
.qmake.stash
*.stash
script*.sh
*.bak

# Rust
apps/*/target/

# Editors
*~
*.swp
*.swo
.idea/
.vscode/

# OS noise
.DS_Store
Thumbs.db
# Copias de seguridad locales
backup/

# Python
__pycache__/
*.pyc

# Artefactos de compilacion de las apps Qt (qmake/moc/rcc) y de Rust.
# Se generan con 'make apps'; nunca son fuente.
*.o
moc_*.cpp
moc_*.h
moc_predefs.h
*.moc
qrc_*.cpp
.qmake.stash
apps/*/Makefile
apps/*/build/
apps/*/build.*/
apps/titan-cli/target/
# Binarios que deja qmake en la raiz de cada app
apps/titan-*/titan-*
!apps/titan-*/titan-*.pro
!apps/titan-*/titan-*.qrc
# Makefile escrito a mano (modulo de gtklock, no es de qmake)
!apps/titan-avisos-bloqueo/Makefile
# Modulo de gtklock que compila build-iso.sh
iso/titan/airootfs/usr/lib/gtklock/titan-avisos-module.so

# Discos virtuales de QEMU y caches
*.raw
*.qcow2
__pycache__/
*.pyc
backup/*.tar.gz
# Binario y restos de compilacion del servicio de usuarios
apps/titan-greeter/helper/titan-usuarios-helper
apps/titan-greeter/helper/Makefile
apps/titan-greeter/helper/*.o
apps/titan-greeter/helper/.qmake.stash
