# Kernel build artifacts (produced by makepkg)
kernel/linux-titanlinux/src/
kernel/linux-titanlinux/pkg/
kernel/linux-titanlinux/*.pkg.tar.*
kernel/linux-titanlinux/*.install
kernel/linux-titanlinux/.BUILDINFO
kernel/linux-titanlinux/.MTREE
kernel/linux-titanlinux/.PKGINFO
# El arbol de fuentes del kernel y su tarball: se descargan y se descomprimen
# con kernel/bump.sh, son ~1.4 GB, y ademas el arbol tiene ficheros que solo se
# diferencian por mayusculas (xt_connmark.h / xt_CONNMARK.h), lo que hace que
# 'git add -A' se negue a anadir el resto con un 'fatal: will not add file
# alias'. No son fuente del proyecto.
kernel/linux-titanlinux/bsrc/
kernel/linux-titanlinux/linux-*.tar.xz
kernel/linux-titanlinux/linux-*.tar.sign
*.pkg.tar.*
*.iso

# Local package repository used by the ISO profile
repo/

# ISO build tree and outputs
out/
out_root/
run/
build/
# Imagenes ISO generadas y sus sumas de verificacion
*.iso
*.iso.sha256
# Archivos comprimidos del proyecto completo (no son fuente)
*.zip
titan-linux.zip

# verify/ NO se ignora: ahi viven los comprobadores, que son fuente del
# proyecto (comprobar-instalador.sh, comprobar-disco.sh, titan-verify.py) y no
# se pueden regenerar. Lo que se ignora es lo que sueltan al ejecutarse.
verify/*.log
verify/*.salida
verify/salidas/

# Files generated by scripts/build-iso.sh inside the archiso profile
iso/titan/airootfs/etc/titan-build.env
iso/titan/airootfs/usr/local/bin/*
iso/titan/airootfs/etc/titan/base.conf
iso/titan/packages.local.*
iso/titan/pacman.conf.local
# El paquete del kernel que la ISO lleva en /titan-repo para que el instalador
# pueda ponerlo en el disco. Son ~160 MB de binario: no va al repositorio, se
# reconstruye con 'makepkg' en kernel/linux-titanlinux.
iso/titan/airootfs/titan-repo/

# OnlyOffice se integra descargando su AppImage (~400 MB); no es fuente.
iso/titan/airootfs/opt/onlyoffice/
iso/titan/airootfs/opt/onlyoffice/DesktopEditors.AppImage

# Binarios de las apps copiados al perfil de la ISO durante el build.
iso/titan/airootfs/usr/local_root/
iso/titan/airootfs/usr/local_root/bin/

# Qt / C++ / Apps build artifacts
apps/*/build/
apps/*/build.*/
apps/*/Makefile
apps/*/titan-acerca
apps/*/titan-cli
apps/*/titan-desktop
apps/*/titan-finder
apps/*/titan-fotos
apps/*/titan-musica
apps/*/titan-panel
apps/*/titan-settings
apps/*/titan-shell
apps/*/titan-terminal
apps/*/*.o
apps/*/moc_*
apps/*/qrc_*
.qmake.stash
*.stash
script*.sh
*.bak

# Rust
apps/*/target/

# Editors
*~
*.swp
*.swo
.idea/
.vscode/

# OS noise
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
